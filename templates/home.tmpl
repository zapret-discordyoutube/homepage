	/* Заставка показывается один раз. Решение принимается до отрисовки, чтобы не мигала. */
	(function () {
		var seen = false;
		try { seen = localStorage.getItem('zpm-intro') === '1' } catch (e) {}
		var calm = window.matchMedia && matchMedia('(prefers-reduced-motion: reduce)').matches;
		if (!seen && !calm) document.documentElement.classList.add('zpm-intro-on');
	})();
</script>
