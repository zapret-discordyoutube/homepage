				<div class="zpm-stat"><b id="zpm-st-week">—</b><span>действий за 7 дней</span></div>
				<div class="zpm-stat"><b id="zpm-st-month">—</b><span>за 30 дней</span></div>
				<div class="zpm-stat"><b id="zpm-st-year">—</b><span>за 12 месяцев</span></div>
				<div class="zpm-weeks" id="zpm-weeks" title="Активность по неделям, последние полгода"></div>
			</div>
		</div>
